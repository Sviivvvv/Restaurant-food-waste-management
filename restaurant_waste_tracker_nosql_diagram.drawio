        <mxCell id="title" value="Restaurant Food Waste Tracker &#8212; MongoDB Document Collections and References (NoSQL)" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;fontColor=#0D7C3D;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="40" y="-140" width="1100" height="40" as="geometry" /></mxCell>
        <mxCell id="note" value="Document database (not relational): each box below is a MongoDB collection of independent JSON-style documents, not a table. There are no database-enforced foreign keys and no JOINs. A field pointing right (&#8594;) just stores another document's ObjectId; Mongoose .populate() resolves it in application code at query time. This is the referencing pattern (over embedding), chosen so shared data such as a branch or category is not duplicated across many waste entries." style="text;html=1;fontSize=11;fontStyle=2;align=left;verticalAlign=middle;whiteSpace=wrap;fillColor=#E4F5EC;strokeColor=#13AA52;spacing=10;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="40" y="-90" width="1480" height="60" as="geometry" /></mxCell>
