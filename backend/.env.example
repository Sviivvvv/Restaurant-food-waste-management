# Copy this file to .env and fill in your own values. Never commit the real .env file.

# Connection string from MongoDB Atlas (Database > Connect > Drivers)
# Example: mongodb+srv://waste_admin:yourpassword@cluster0.xxxxx.mongodb.net/waste_tracker?retryWrites=true&w=majority
MONGO_URI=your_mongodb_atlas_connection_string_here

# Port the backend server listens on
PORT=5000

# Secret used to sign login tokens, use any long random string
JWT_SECRET=change_this_to_a_long_random_string

# How long a login token stays valid
JWT_EXPIRES_IN=7d

# Address of the frontend app, used to allow it to call this API
CLIENT_ORIGIN=http://localhost:5173
